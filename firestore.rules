rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Movies collection
    match /movies/{movieId} {
      // Helper function to validate movie payload
      function isValidMovieData(data) {
        return data.userId is string 
          && data.userId == request.auth.uid
          && data.title is string 
          && data.title.trim().size() > 0 
          && data.title.size() <= 100
          && data.director is string 
          && data.director.trim().size() > 0 
          && data.director.size() <= 60
          && data.genre in ['Action', 'Comedy', 'Drama', 'Horror']
          && data.status in ['Plan to Watch', 'Watching', 'Watched']
          && (!('rating' in data) || data.rating == null || (data.rating is int && data.rating >= 0 && data.rating <= 5))
          && (!('favorite' in data) || data.favorite is bool)
          && (!('notes' in data) || data.notes == null || (data.notes is string && data.notes.size() <= 300));
      }

      // Read rule: authenticated user only, and only own documents
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      
      // Create rule: authenticated user, incoming userId must match auth UID, and payload must be valid
      allow create: if request.auth != null 
        && request.resource.data.userId == request.auth.uid 
        && isValidMovieData(request.resource.data);
      
      // Update rule: only owner can update, cannot change ownership, and updated payload must be valid
      allow update: if request.auth != null 
        && resource.data.userId == request.auth.uid
        && request.resource.data.userId == request.auth.uid
        && isValidMovieData(request.resource.data);
        
      // Delete rule: only owner can delete
      allow delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }
  }
}
